Attribute VB_Name = "BloombergVersStatique"
Option Explicit
' Copie les dernières valeurs récupérées sur Bloomberg (BDH, BQL, BDP) dans les colonnes statiques du classeur.
' Usage : lancer sur un poste Bloomberg, enregistrer, puis diffuser le fichier : un utilisateur sans terminal
' retrouve ces valeurs (chaque courbe bascule seule en STATIQUE quand Bloomberg ne répond pas).

Private Function EstNombre(ByVal v As Variant) As Boolean
    EstNombre = False
    If IsError(v) Then Exit Function
    If IsEmpty(v) Then Exit Function
    If VarType(v) = vbString Then Exit Function
    EstNombre = IsNumeric(v) Or IsDate(v)
End Function

Public Sub CopierBloombergVersStatique()
    Dim ws As Worksheet, r As Long, nom As Variant
    Dim nSw As Long, nGov As Long, nFx As Long, nPar As Long, ignores As String
    If MsgBox("Copier les dernières valeurs Bloomberg dans les colonnes statiques ?" & vbCrLf & _
              "Les valeurs statiques actuelles seront remplacées.", vbYesNo + vbQuestion, "Bloomberg vers statique") <> vbYes Then Exit Sub
    Application.ScreenUpdating = False
    Application.Calculate

    ' --- Paramètres : taux de financement (BDP brut en colonne G -> statique en colonne E)
    Set ws = ThisWorkbook.Worksheets("Param" & ChrW(232) & "tres")
    For Each nom In Array(7, 14)
        If EstNombre(ws.Cells(nom, 7).Value) Then ws.Cells(nom, 5).Value = ws.Cells(nom, 7).Value: nPar = nPar + 1
    Next nom

    ' --- Courbes swap : BDH (colonne D) -> statique (colonne E)
    For Each nom In Array("SW_E6M", "SW_OIS", "SW_SOFR")
        Set ws = ThisWorkbook.Worksheets(CStr(nom))
        If Application.WorksheetFunction.Count(ws.Range("D16:D79")) >= 8 Then
            For r = 16 To 79
                If EstNombre(ws.Cells(r, 4).Value) Then ws.Cells(r, 5).Value = ws.Cells(r, 4).Value: nSw = nSw + 1
            Next r
        Else
            ignores = ignores & vbCrLf & " - " & nom & " (pas de donn" & ChrW(233) & "es Bloomberg)"
        End If
    Next nom

    ' --- Courbes souveraines : zone BQL B:F -> statique (ID, maturité, rendement, coupon, prix)
    For Each nom In Array("GOV_DE", "GOV_FR", "GOV_IT", "GOV_ES", "GOV_NL", "GOV_BE", "GOV_EU", "GOV_US")
        Set ws = ThisWorkbook.Worksheets(CStr(nom))
        If Application.WorksheetFunction.Count(ws.Range("F16:F75")) >= 8 Then
            ws.Range("I16:K79").ClearContents
            ws.Range("CM16:CN79").ClearContents
            For r = 16 To 75
                If Len(ws.Cells(r, 2).Value) > 0 And EstNombre(ws.Cells(r, 3).Value) And EstNombre(ws.Cells(r, 6).Value) And EstNombre(ws.Cells(r, 5).Value) Then
                    ws.Range("I" & r).Value = ws.Cells(r, 2).Value
                    ws.Range("J" & r).Value = ws.Cells(r, 3).Value
                    ws.Range("K" & r).Value = ws.Cells(r, 6).Value
                    ws.Range("CM" & r).Value = ws.Cells(r, 4).Value
                    ws.Range("CN" & r).Value = ws.Cells(r, 5).Value
                    nGov = nGov + 1
                End If
            Next r
        Else
            ignores = ignores & vbCrLf & " - " & nom & " (pas de donn" & ChrW(233) & "es BQL)"
        End If
    Next nom

    ' --- FX : BDP (colonne F) -> statique (colonne E) ; taux JPY : BDP (H) -> statique (G)
    Set ws = ThisWorkbook.Worksheets("FX")
    For r = 10 To 22
        If (r <= 14 Or r >= 18) And EstNombre(ws.Cells(r, 6).Value) Then ws.Cells(r, 5).Value = ws.Cells(r, 6).Value: nFx = nFx + 1
    Next r
    For r = 26 To 29
        If EstNombre(ws.Cells(r, 8).Value) Then ws.Cells(r, 7).Value = ws.Cells(r, 8).Value: nFx = nFx + 1
    Next r
    ws.Range("E5").Value = "Statique copi" & ChrW(233) & " de Bloomberg le " & Format(Now, "dd/mm/yyyy hh:nn")
    ws.Range("E5").Font.Italic = True

    ' --- Date de valorisation : date des données statiques
    If MsgBox("Mettre la date de valorisation (Param" & ChrW(232) & "tres!C5) " & ChrW(224) & " aujourd'hui (" & Format(Date, "dd/mm/yyyy") & ") ?" & vbCrLf & _
              "Recommand" & ChrW(233) & " : elle fixe la date des donn" & ChrW(233) & "es statiques.", vbYesNo + vbQuestion, "Date de valorisation") = vbYes Then
        ThisWorkbook.Worksheets("Param" & ChrW(232) & "tres").Range("C5").Value = Date
    End If
    Application.ScreenUpdating = True
    Application.Calculate
    MsgBox "Copie termin" & ChrW(233) & "e." & vbCrLf & _
           "Param" & ChrW(232) & "tres : " & nPar & " ; swaps : " & nSw & " ; obligations : " & nGov & " ; FX : " & nFx & _
           IIf(Len(ignores) > 0, vbCrLf & vbCrLf & "Non copi" & ChrW(233) & "es :" & ignores, "") & vbCrLf & vbCrLf & _
           "Enregistrez le fichier (.xlsm) avant diffusion.", vbInformation, "Bloomberg vers statique"
End Sub
